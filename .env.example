# Postgres con extensión pgvector (docker compose up -d db levanta uno local)
DATABASE_URL=postgresql+psycopg://vigente:vigente@localhost:5433/vigente

# Requerida solo para el endpoint /ask (generación). El resto del pipeline
# (ingesta, chunking, embeddings, retrieval) no la necesita.
ANTHROPIC_API_KEY=

# Modelo de embeddings local (sentence-transformers) — no requiere API key.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Orígenes permitidos por CORS para el frontend, separados por coma.
ALLOWED_ORIGINS=http://localhost:5173
